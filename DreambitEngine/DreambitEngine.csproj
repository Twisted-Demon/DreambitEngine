<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <BaseOutputPath>Build\</BaseOutputPath>
        <AssemblyName>Dreambit</AssemblyName>
        <RootNamespace>Dreambit</RootNamespace>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <OutputPath>$(BaseOutputPath)</OutputPath> <!-- No version folder for Debug -->
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <OutputPath>$(BaseOutputPath)</OutputPath> <!-- No version folder for Release -->
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="FontStashSharp.MonoGame" Version="1.5.6" />
        <PackageReference
                Include="MonoGame.Framework.Native"
                Version="3.8.5">
            <PrivateAssets>All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="Spectre.Console" Version="0.57.2" />
        <PackageReference Include="YamlDotNet" Version="18.1.0" />
    </ItemGroup>
    <ItemGroup>
      <Compile Remove="bin\**" />
      <Compile Remove="Content\obj\**" />
    </ItemGroup>
    <ItemGroup>
      <EmbeddedResource Remove="bin\**" />
      <EmbeddedResource Remove="Content\obj\**" />
    </ItemGroup>
    <ItemGroup>
      <None Remove="bin\**" />
      <None Remove="Content\obj\**" />
    </ItemGroup>
    <ItemGroup>
      <ProjectReference Include="..\LDtkMonogame\LDtk\LDtk.csproj" />
    </ItemGroup>
    <PropertyGroup>
        <MonoGameExtendedPipelineReferencePath>$(MSBuildThisFileDirectory)../Includes</MonoGameExtendedPipelineReferencePath>
    </PropertyGroup>

</Project>