<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <BaseOutputPath>Build\</BaseOutputPath>
        <RootNamespace>Dreambit</RootNamespace>
        <AssemblyName>Dreambit.ContentPipelineExtensions</AssemblyName>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <OutputPath>$(BaseOutputPath)</OutputPath> <!-- No version folder for Debug -->
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <OutputPath>$(BaseOutputPath)</OutputPath> <!-- No version folder for Release -->
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\MonoGame\MonoGame.Framework\MonoGame.Framework.Native.csproj" />
        <ProjectReference Include="..\MonoGame\MonoGame.Framework.Content.Pipeline\MonoGame.Framework.Content.Pipeline.csproj" />
    </ItemGroup>
    <ItemGroup>
      <ProjectReference Include="..\DreambitEngine\DreambitEngine.csproj" />
    </ItemGroup>
    <ItemGroup>
      <Reference Include="Newtonsoft.Json">
        <HintPath>..\Includes\Newtonsoft.Json.dll</HintPath>
      </Reference>
    </ItemGroup>
</Project>
