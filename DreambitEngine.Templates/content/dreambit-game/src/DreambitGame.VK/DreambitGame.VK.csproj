<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <MonoGamePlatform>DesktopVK</MonoGamePlatform>
    <DreambitContentBuildEnabled>true</DreambitContentBuildEnabled>
    <DreambitProjectRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../..'))</DreambitProjectRoot>
    <DreambitContentRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../DreambitGame.Content/Assets'))</DreambitContentRoot>
    <DreambitAssetRegistry>$([System.IO.Path]::GetFullPath('$(DreambitProjectRoot)/.dreambit/assets.json'))</DreambitAssetRegistry>

    <BaseOutputPath>$(MSBuildProjectDirectory)/Build/</BaseOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Icon.ico" />
    <None Remove="Icon.bmp" />
    <EmbeddedResource Include="Icon.ico" LogicalName="Icon.ico" />
    <EmbeddedResource Include="Icon.bmp" LogicalName="Icon.bmp" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.Native" />
    <PackageReference Include="MonoGame.Runtime.Windows.Vulkan" />
    <PackageReference Include="MonoGame.Runtime.Mac.Vulkan" />
    <PackageReference Include="MonoGame.Runtime.Linux.Vulkan" />
    <PackageReference Include="DreambitEngine.Build" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The executable references only game code as a project. Dreambit build tools
         remain private package assets and are never copied into runtime output. -->
    <ProjectReference Include="../DreambitGame/DreambitGame.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Rider/Visual Studio fast up-to-date checks must notice content changes. -->
    <UpToDateCheckInput Include="../DreambitGame.Content/Assets/**/*" />
    <UpToDateCheckInput Include="../DreambitGame.Content/Builder/**/*.cs" />
    <UpToDateCheckInput Include="../DreambitGame.Content/DreambitGame.Content.csproj" />
  </ItemGroup>
</Project>
