<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <RollForward>Major</RollForward>
        <PublishReadyToRun>false</PublishReadyToRun>
        <TieredCompilation>false</TieredCompilation>

        <BaseOutputPath>$(MSBuildProjectDirectory)\Build\</BaseOutputPath>

        <!-- Keep paths tidy -->
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    </PropertyGroup>
    <PropertyGroup>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Icon.ico</ApplicationIcon>
    </PropertyGroup>
    <ItemGroup>
        <None Remove="Icon.ico"/>
        <None Remove="Icon.bmp"/>
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="Icon.ico">
            <LogicalName>Icon.ico</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="Icon.bmp">
            <LogicalName>Icon.bmp</LogicalName>
        </EmbeddedResource>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5" />
        <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.5" />
    </ItemGroup>
    <ItemGroup>
      <ClCompile Include="Content\Effects\ColorCorrection.fx" />
      <ClCompile Include="Content\Effects\DefferedRenderCombine.fx" />
      <ClCompile Include="Content\Effects\ForwardDiffuse.fx" />
      <ClCompile Include="Content\Effects\ForwardLighting.fx" />
      <ClCompile Include="Content\Effects\ForwardLighting2D.fx" />
      <ClCompile Include="Content\Effects\PointLight2D.fx" />
      <ClCompile Include="Content\Effects\Tint.fx" />
    </ItemGroup>
    <ItemGroup>
      <None Remove="Content\Fonts\monogram.ttf" />
      <Content Include="Content\Fonts\monogram.ttf">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <None Remove="Content\content.pak" />
      <Content Include="Content\content.pak">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <None Remove="Content\Ui\menu.xml" />
      <Content Include="Content\Ui\menu.xml">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <None Remove="Content\Ui\pong_scoreboard.xml" />
      <Content Include="Content\Ui\pong_scoreboard.xml">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>
    <ItemGroup>
      <ProjectReference Include="..\DreambitEngine\DreambitEngine.csproj" />
    </ItemGroup>
    <Target Name="RestoreDotnetTools" BeforeTargets="Restore">
        <Message Text="Restoring dotnet tools" Importance="High"/>
        <Exec Command="dotnet tool restore"/>
    </Target>
</Project>
