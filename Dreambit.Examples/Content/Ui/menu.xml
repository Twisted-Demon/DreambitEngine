<Ui>
    <StackPanel id="main-menu"
                anchor="Center"
                origin="Center"
                width="320"
                height="200"
                padding="24"
                spacing="16">
        <Text id="menu-title"
              width="100%"
              height="48"
              text="Dreambit UI"
              font="monogram"
              font-size="32"
              text-color="#FFFFFF"
              horizontal-alignment="Center" />

        <Button id="play-button"
                width="100%"
                height="64"
                text="Play"
                font="monogram"
                font-size="24"
                text-color="#FFFFFF"
                sprite="Ui/red-button.sprite"
                background-tint="#FFFFFF"
                hover-tint="#D8E8FF"
                pressed-tint="#9FB9D4" />
    </StackPanel>
</Ui>
